# Supabase (cloud saves and accounts). Optional: without these the app runs
# fully offline as a guest and saves to this browser only.
# The anon/publishable key is client-safe; RLS enforces ownership.
# NEVER put the service role key here or in any NEXT_PUBLIC_* var.
# In the Supabase dashboard, add <origin>/auth/callback to the Auth redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# On hosted deployments, set this to the public app origin so auth callbacks
# never derive redirect hosts from forwarded request headers.
NEXT_PUBLIC_SITE_URL=""
